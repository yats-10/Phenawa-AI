# Copy this file to .env and fill in your real values.
# Never commit the real .env file to version control.

PORT=3001
NODE_ENV=development

# Postgres connection string.
# Railway: leave unset and reference the Postgres service variable instead:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:pass@host:5432/trialroom

# TLS for the database connection. Leave unset to decide from the host
# (localhost and *.railway.internal get plain, everything else gets TLS).
# DATABASE_SSL=true

# Comma-separated list of browser origins allowed to call this API.
# Leave empty ONLY for local development — empty means "allow every origin".
# A leading *. matches subdomains, which covers Vercel preview deployments.
# Example: https://phenawa.vercel.app,https://*.vercel.app,http://localhost:4300
CORS_ORIGINS=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_string
JWT_EXPIRES_IN=30d

# Different secret from JWT_SECRET
ADMIN_JWT_SECRET=replace_with_different_64_char_random_string
ADMIN_JWT_EXPIRES_IN=24h

# Secret header value for the one-time POST /admin/seed endpoint
ADMIN_SEED_SECRET=replace_with_seed_secret

# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key
# Optional: gpt-image-2.5-flare for faster edits
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Shown to shopkeepers when access expires or the account is deactivated
ADMIN_PHONE=9XXXXXXXXX

# Daily generation count threshold before a warning is logged
MAX_DAILY_ALERT_THRESHOLD=80
