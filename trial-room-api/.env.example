# Copy this file to .env and fill in your real values.
# Never commit the real .env file to version control.

PORT=3000
DATABASE_URL=postgresql://user:pass@host:5432/trialroom

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_string
JWT_EXPIRES_IN=30d

# Different secret from JWT_SECRET
ADMIN_JWT_SECRET=replace_with_different_64_char_random_string
ADMIN_JWT_EXPIRES_IN=24h

# Secret header value for /admin/seed endpoint
ADMIN_SEED_SECRET=replace_with_seed_secret

# Google AI Studio key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_ai_studio_api_key

# Cloudflare R2 — Dashboard → R2 → Manage R2 API Tokens
CLOUDFLARE_R2_ACCOUNT_ID=your_account_id
CLOUDFLARE_R2_ACCESS_KEY=your_access_key_id
CLOUDFLARE_R2_SECRET_KEY=your_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=trial-room
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Shown to shopkeepers when access expires or account is deactivated
ADMIN_PHONE=9XXXXXXXXX

# Daily generation count threshold before a warning is logged
MAX_DAILY_ALERT_THRESHOLD=80
