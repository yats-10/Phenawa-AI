{
  "name": "trial-room-app",
  "version": "0.0.1",
  "author": "Trial Room",
  "homepage": "./",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4300",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "android:sync:local": "ng build --configuration production,android-local && PHENAWA_ANDROID_LOCAL=1 cap sync android",
    "android:apk:local": "npm run android:sync:local && cd android && ./gradlew assembleDebug",
    "android:sync:usb": "ng build --configuration production,android-usb && PHENAWA_ANDROID_LOCAL=1 cap sync android",
    "android:apk:usb": "npm run android:sync:usb && cd android && ./gradlew assembleDebug",
    "android:sync:release": "node scripts/sync-android-release.mjs",
    "test": "ng test",
    "lint": "ng lint",
    "ionic:serve": "ionic serve",
    "ionic:build": "ionic build",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android"
  },
  "dependencies": {
    "@angular/common": "^17.3.7",
    "@angular/compiler": "^17.3.7",
    "@angular/core": "^17.3.7",
    "@angular/forms": "^17.3.7",
    "@angular/platform-browser": "^17.3.7",
    "@angular/platform-browser-dynamic": "^17.3.7",
    "@angular/router": "^17.3.7",
    "@capacitor/android": "^8.5.2",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@ionic/angular": "^7.8.4",
    "ionicons": "^7.4.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "~0.14.5"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.7",
    "@angular/cli": "^17.3.7",
    "@angular/compiler-cli": "^17.3.7",
    "@capacitor/cli": "^8.5.2",
    "@ionic/angular-toolkit": "^11.0.1",
    "@types/jasmine": "~5.1.4",
    "@types/node": "^20.12.5",
    "jasmine-core": "~5.1.2",
    "karma": "~6.4.3",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.4.5"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  }
}
